# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- Virtual environments ---
mlenv/
venv/
.venv/
env/
ENV/

# --- Project data & model artifacts (large, regenerated by scripts) ---
# Raw dataset — re-fetch with: python -m ml.data.download_dataset
ML/data/raw/
# Preprocessed arrays/encoders — regenerate with: python -m ml.data.preprocess / preprocess_v2
ML/data/processed/
ML/data/processed_v2/
# Trained models — regenerate with: python -m ml.train_all / train_all_v2
ML/models_saved/
ML/models_saved_v2/
# Extra safety: ignore generated binary artifacts anywhere in the ML project
ML/**/*.npy
ML/**/*.joblib

# Keep the small comparison tables/charts (reports/, reports_v2/) tracked —
# they're lightweight and are the actual evidence of results.
# If you'd rather regenerate those too, uncomment:
# reports/
# reports_v2/

# --- Live capture artifacts (Phase 2, once added) ---
*.pcap
*.pcapng
captures/

# --- Jupyter ---
.ipynb_checkpoints/

# --- Environment / secrets ---
.env
.env.*

