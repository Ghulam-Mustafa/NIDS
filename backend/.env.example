PORT=5000

# Folder that holds your ML project (the one containing the "nids" package, config.yaml and models/)
NIDS_DIR=../ML
# Python that has the ML requirements installed. With a venv inside ML on Windows:
# PYTHON_BIN=../ML/.venv/Scripts/python.exe     (Linux/Mac: ../ML/.venv/bin/python)
PYTHON_BIN=python

# pcap -> flows converter: "cfm" (official Java CICFlowMeter) or "python" (pip install cicflowmeter)
CONVERTER=cfm
# Full path to cfm.bat (Windows) or cfm (Linux). Only used when CONVERTER=cfm
CFM_PATH=C:\tools\CICFlowMeter-4.0\bin\cfm.bat

MAX_UPLOAD_MB=1024
